      <aliases enabled='yes' />
      <column caption='Delivery_Performance' datatype='string' name='[Calculation_1778244373942272]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Delivery_Time_Min] &lt;= 30 THEN &quot;Fast&quot;&#13;&#10;ELSE &quot;Delayed&quot;&#13;&#10;END' />
      </column>
      <column caption='Orders_Identification' datatype='string' name='[Calculation_1778244375199745]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Profit]&lt; 0 THEN &quot;Loss&quot;&#13;&#10;ELSE &quot;Profit&quot;&#13;&#10;END' />
      </column>
      <column caption='Rank_Sales' datatype='boolean' name='[Calculation_1778244376932354]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK(SUM([Sales])) &lt;= [Parameters].[Parameter 1]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
